{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Edit(./.env)",
      "Read(./infra/terraform.tfvars)",
      "Edit(./infra/terraform.tfvars)"
    ],
    "ask": [
      "Bash(make deploy*)",
      "Bash(make run*)",
      "Bash(terraform apply*)",
      "Bash(terraform destroy*)",
      "Bash(terraform -chdir* apply*)",
      "Bash(terraform -chdir* destroy*)",
      "Bash(gh workflow run*)",
      "Bash(gh release create*)",
      "Bash(git push *--tags*)",
      "Bash(git push *--follow-tags*)",
      "Bash(git push * v*)",
      "Bash(git push *refs/tags/*)"
    ]
  },
  "extraKnownMarketplaces": {
    "oskarrn93-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/oskarrn93/claude-plugins.git"
      }
    }
  },
  "enabledPlugins": {
    "golang@oskarrn93-plugins": true,
    "git@oskarrn93-plugins": true
  }
}
